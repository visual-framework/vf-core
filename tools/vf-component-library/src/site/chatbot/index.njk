<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Assistant | Chatbot</title>
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/scripts/scripts.js"></script>
  <!-- Add a specific script for the standalone chatbot page -->
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      console.log("Chatbot page loaded, ensuring standalone chatbot is initialized");
      // Single function to initialize all chatbot components
      const initChatbot = () => {
        if (typeof window.initVFChatbotStandalone === "function") {
          window.initVFChatbotStandalone();

          return true;
        }
        return false;
      };

      // Try to initialize immediately
      if (!initChatbot()) {
        // If not successful, try once after a short delay
        console.log("Waiting for chatbot scripts to load...");
        setTimeout(initChatbot, 500);
      }
    });
  </script>
</head>
<body class="vf-body vf-stack">
  <nav class="vf-breadcrumbs" aria-label="Breadcrumb">
    <ul class="vf-breadcrumbs__list | vf-list vf-list--inline">
      <li class="vf-breadcrumbs__item">
        <a href="/" class="vf-breadcrumbs__link">Home</a>
      </li>
      <li class="vf-breadcrumbs__item" aria-current="location">
        AI Assistant
      </li>
    </ul>
  </nav>
  {% render '@vf-chatbot-standalone', {
    title: "AI Assistant",
    welcome_title: "AI assistant",
    welcome_description: "Welcome! I'm here to help you.",
    welcome_message: "Hello! How can I help you today?",
    input_placeholder: "Ask me ...",
    show_suggestions: true,
    show_close_button: true,
    ai_icon: "../../assets/vf-chatbot/assets/vf-chatbot--icon-16x16-dark-green.svg",
    welcome_logo: "../../assets/vf-chatbot/assets/vf-chatbot--icon-64x64-dark-green.svg"
  } %}

  <!-- Add a data attribute to indicate this is the standalone page -->
  <div data-vf-js-standalone-chatbot-page style="display:none;"></div>
  <script src="./chatbot-api-handler.js"></script>
</body>
</html>
