<div class="vf-chatbot-router" data-vf-js-chatbot-router {% if context.chatbotRoutes.multiSelect %}data-multiSelect="true"{% endif %}>
  <button class="vf-chatbot-router__title" data-vf-js-router-toggle>
    <img src="../../assets/vf-chatbot/assets/ai-assistant-icon.svg" alt="AI Assistant">
    <div class="vf-chatbot-router__title-content">
      <span class="vf-chatbot-router__main-text">AI Assistant</span>
      <span class="vf-chatbot-router__title-text">Select services</span>
    </div>
    <span class="vf-chatbot-router__chevron">&#8964;</span>
  </button>

  <div class="vf-chatbot-router__dropdown" data-vf-js-router-dropdown>

    {% if context.chatbotRoutes.showSearch and (context.chatbotRoutes.routes | length > context.chatbotRoutes.showSearchThreshold) %}
    <div class="vf-chatbot-router__search">
      <input type="text" placeholder="Search" data-vf-js-router-search>
    </div>
    {% endif %}

    {% if context.chatbotRoutes.multiSelect %}
    <div class="vf-chatbot-router__header">
      <span>Select up to {{ context.chatbotRoutes.maxMultiSelect }} services</span>
      <a href="#" class="vf-chatbot-router__clear" data-vf-js-router-clear>Clear all</a>
    </div>
    {% endif %}

    <ul class="vf-chatbot-router__list">
      {% for route in context.chatbotRoutes.routes %}
      <li class="vf-chatbot-router__item{% if route.selected %} vf-chatbot-router__item--selected{% endif %}"
          data-vf-js-router-item
          data-route-id="{{ route.id }}">
        <div class="vf-chatbot-router__item-content">
          <div class="vf-chatbot-router__item-title">{{ route.title }}</div>
          <div class="vf-chatbot-router__item-description">{{ route.description }}</div>
        </div>
        <span class="vf-chatbot-router__tick">&#9143;</span>
      </li>
      {% endfor %}
    </ul>
  </div>
</div>
