<button 
  class="vf-chatbot-fab"
  aria-label="Open chat"
  data-vf-js-chatbot-fab
  {% if fab_active %}class="vf-chatbot-fab--active"{% endif %}
>
  {# Chat icon when closed #}
  <svg class="vf-chatbot-fab__icon vf-chatbot-fab__icon--chat" viewBox="0 0 24 24">
    <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/>
  </svg>

  {# Close icon when open #}
  <svg class="vf-chatbot-fab__icon vf-chatbot-fab__icon--close" viewBox="0 0 24 24" style="display: none;">
    <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
  </svg>

  {% if notification_count > 0 %}
  <span class="vf-chatbot-fab__badge">{{ notification_count }}</span>
  {% endif %}
</button>